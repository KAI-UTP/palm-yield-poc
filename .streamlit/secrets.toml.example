# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.
# Never commit the real file.

# Locks the Analytics Workbench for the analytics team. Choose your own; share it only with analysts.
WORKBENCH_PASSWORD = "choose-a-long-password"

# Optional, for the AI service in core/ai.py (used by the API in production; the workbench itself has no AI page).
# GEMINI_API_KEY = "paste-your-key-here"
# ANTHROPIC_API_KEY = "..."

# Lets analysts publish checked results to the PalmYield web app (Data sources page > Publish to PalmYield).
# A fine-grained GitHub token with "Contents: read and write" on this repository only.
# GITHUB_TOKEN = "github_pat_..."
# GITHUB_REPO = "KAI-UTP/palm-yield-poc"
# GITHUB_BRANCH = "main"
