# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.
# Never commit the real file.

# Free key from https://aistudio.google.com ("Get API key")
GEMINI_API_KEY = "paste-your-key-here"

# Optional: a specific model name if Google retires the default alias
# GEMINI_MODEL = "gemini-flash-latest"

# Optional: use Claude instead (paid). Also add "anthropic" to requirements.txt.
# ANTHROPIC_API_KEY = "..."
# CLAUDE_MODEL = "claude-opus-5-5"
# AI_PROVIDER = "claude"
